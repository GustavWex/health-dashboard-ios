    "title": {
      "size": 28,
      "line": 36,
      "weight": "semibold"
    },
    "heading": {
      "size": 17,
      "line": 24,
      "weight": "semibold"
    },
    "value": {
      "size": 22,
      "line": 24,
      "weight": "semibold",
      "tabular": true
    },
    "body": {
      "size": 17,
      "line": 24,
      "weight": "regular"
    },
    "label": {
      "size": 13,
      "line": 18,
      "weight": "regular",
      "opacity": 0.6
    }
  },
  "motion": {
    "mouthMorph": 0.6,
    "glowFade": 0.8,
    "blinkEvery": [
      3,
      5
    ],
    "blink": 0.24,
    "wink": 0.9,
    "curve": "easeInOut",
    "reduceMotion": "switch instantly"
  },
  "moodFace": {
    "faceHeightInTile": 0.56,
    "push": "mood 1",
    "moderate": "mood 0",
    "recover": "mood -1",
    "fromRecovery": "clamp((score - 50) / 17, -1, 1)"
  }
